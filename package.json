{
  "name": "power-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "service:install": "node --import tsx scripts/launchd.ts install",
    "service:start": "node --import tsx scripts/launchd.ts start",
    "service:stop": "node --import tsx scripts/launchd.ts stop",
    "service:restart": "node --import tsx scripts/launchd.ts restart",
    "service:status": "node --import tsx scripts/launchd.ts status",
    "service:uninstall": "node --import tsx scripts/launchd.ts uninstall"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
