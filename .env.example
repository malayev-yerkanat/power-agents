# Optional API connections. CLI connections use their own existing login.
# Do not commit .env or share keys with browser clients.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional Telegram notifications. Create a bot with @BotFather, then pair it in the app.
TELEGRAM_BOT_TOKEN=
# Separate Codex bot; never reuse the Claude/Power Agents TELEGRAM_BOT_TOKEN.
CODEX_TELEGRAM_BOT_TOKEN=
# Mirror supported Codex Desktop approvals and questions after pairing its bot.
CODEX_TELEGRAM_ENABLED=false
PORT=4317

# Media pipeline: path to the content project pipeline/stages directory.
REEL_PIPELINE_DIR=
ELEVENLABS_API_KEY=
